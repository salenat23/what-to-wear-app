html, body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  background: #f4efe9;
  color: #171411;
  font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  width: 100%;
}

.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(180, 164, 146, 0.18), transparent 26%),
    linear-gradient(180deg, #f5f0ea 0%, #efe7df 100%);
  display: flex;
  justify-content: center;
  padding: 32px 18px 64px;
}

.app-frame {
  width: min(100%, 430px);
  background: rgba(255, 255, 255, 0.54);
  border: 1px solid rgba(35, 28, 23, 0.08);
  box-shadow: 0 20px 60px rgba(39, 31, 25, 0.08);
  border-radius: 28px;
  padding: 22px 18px 30px;
  backdrop-filter: blur(12px);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.eyebrow,
.overline {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 10px;
  color: #7a6d63;
}

.topbar h2,
.section-header h3,
.modal-header h3 {
  margin: 6px 0 0;
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.05em;
}

.icon-button,
.close-button {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(23, 20, 17, 0.12);
  background: rgba(255, 255, 255, 0.5);
  color: #1b1714;
}

.hero-card {
  background: linear-gradient(135deg, #efe3d8 0%, #f9f5f1 100%);
  border: 1px solid rgba(26, 20, 17, 0.05);
  border-radius: 24px;
  padding: 20px 18px 18px;
}

.hero-copy h1 {
  margin: 8px 0 16px;
  font-size: clamp(2rem, 6vw, 3rem);
  line-height: 0.96;
  letter-spacing: -0.08em;
  font-weight: 600;
}

.cta-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.primary-button,
.secondary-button,
.upload-action,
.tab,
.chip,
.text-button {
  border-radius: 999px;
  transition: all 0.2s ease;
}

.primary-button,
.secondary-button,
.upload-action {
  border: none;
  padding: 12px 16px;
  font-size: 0.92rem;
  font-weight: 600;
}

.primary-button {
  background: #1b1714;
  color: #f8f4ef;
  box-shadow: 0 10px 24px rgba(27, 23, 20, 0.18);
}

.secondary-button {
  background: rgba(255, 255, 255, 0.4);
  color: #1b1714;
  border: 1px solid rgba(23, 20, 17, 0.08);
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0 20px;
}

.stat-card {
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(23, 20, 17, 0.08);
  border-radius: 18px;
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stat-card span {
  color: #766d65;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.stat-card strong {
  font-size: 1.5rem;
  letter-spacing: -0.06em;
}

.tab-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  background: rgba(255, 255, 255, 0.35);
  border: 1px solid rgba(23, 20, 17, 0.06);
  border-radius: 999px;
  padding: 6px;
}

.tab {
  flex: 1;
  border: none;
  background: transparent;
  color: #564d47;
  padding: 10px 8px;
  font-weight: 600;
}

.tab.active {
  background: #1b1714;
  color: #f8f4ef;
}

.search-card {
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(23, 20, 17, 0.08);
  border-radius: 20px;
  padding: 14px;
}

.search-line {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(23, 20, 17, 0.08);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.56);
  padding: 10px 12px;
}

.search-icon {
  color: #7a6d63;
  font-size: 1.2rem;
}

.search-line input {
  width: 100%;
  border: none;
  background: transparent;
  color: #171411;
  outline: none;
  font-size: 0.94rem;
}

.filter-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.chip {
  border: 1px solid rgba(23, 20, 17, 0.08);
  padding: 8px 12px;
  background: transparent;
  color: #4b433d;
}

.chip.active {
  background: #171411;
  color: #f7f0ea;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 26px 0 14px;
}

.section-header.compact {
  margin-top: 0;
}

.section-header h3 {
  font-size: 1.3rem;
}

.text-button {
  border: none;
  background: transparent;
  color: #665d57;
  font-weight: 600;
}

.item-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.item-card {
  background: rgba(255, 255, 255, 0.52);
  border: 1px solid rgba(23, 20, 17, 0.08);
  border-radius: 18px;
  overflow: hidden;
}

.image-wrap {
  height: 180px;
  overflow: hidden;
}

.image-wrap img {
  height: 100%;
  object-fit: cover;
}

.item-copy {
  padding: 12px 10px 14px;
}

.name-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.name-line h4 {
  margin: 0;
  font-size: 0.95rem;
  letter-spacing: -0.03em;
}

.name-line span,
.item-copy p {
  color: #7a6d63;
  font-size: 0.75rem;
}

.item-copy p {
  margin: 6px 0 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}

.mini-tag {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 999px;
  background: #f1e8e0;
  color: #332d2a;
  font-size: 0.68rem;
}

.suggestion-panel {
  margin-top: 26px;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(23, 20, 17, 0.08);
  border-radius: 22px;
  padding: 18px 14px;
}

.suggestion-list {
  display: grid;
  gap: 10px;
  margin-top: 10px;
}

.look-card {
  background: linear-gradient(135deg, rgba(244, 236, 230, 0.9), rgba(255,255,255,0.5));
  border: 1px solid rgba(23, 20, 17, 0.06);
  border-radius: 16px;
  padding: 12px 12px 14px;
}

.look-label {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #756c63;
  margin-bottom: 8px;
}

.look-pieces {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.look-pieces span {
  background: rgba(255,255,255,0.5);
  border: 1px solid rgba(23, 20, 17, 0.06);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.76rem;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  background: rgba(18, 15, 13, 0.42);
  padding: 18px;
}

.modal-card {
  width: min(100%, 430px);
  background: #f9f4f0;
  border-radius: 28px 28px 18px 18px;
  border: 1px solid rgba(23, 20, 17, 0.06);
  padding: 18px 16px 20px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.upload-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 18px;
}

.upload-action {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(23, 20, 17, 0.08);
  color: #1b1714;
}

.field-label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #403930;
  font-size: 0.82rem;
  margin-bottom: 14px;
}

.field-label input,
.field-label select {
  width: 100%;
  border: 1px solid rgba(23, 20, 17, 0.08);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  padding: 12px 14px;
  color: #171411;
  outline: none;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 10px;
}

@media (min-width: 640px) {
  .app-frame {
    padding: 26px 22px 36px;
  }

  .item-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
